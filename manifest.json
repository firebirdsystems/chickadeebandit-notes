{
  "id": "notes",
  "name": "Shared Notes",
  "version": "1.0.0",
  "description": "Shared notes — wifi passwords, house rules, recipes, anything the whole family needs.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": [
    "notes",
    "shared",
    "family"
  ],
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "automation_actions": {
    "add_note": {
      "title": "Save a note",
      "description": "Write a note when another app's event fires — a record of what happened, kept where the household already looks for notes.",
      "params": {
        "created_by": {
          "type": "member",
          "label": "Filed under",
          "required": true
        },
        "title": {
          "type": "text",
          "label": "Note title",
          "required": true
        },
        "content": {
          "type": "text",
          "label": "Note body",
          "default": ""
        }
      },
      "dedupe": {
        "table": "notes",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "notes",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "content": ":content",
            "created_by": ":created_by",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "member_references": {
    "notes": { "column": "created_by", "on_removed": "keep" }
  },
  "row_policies": {
    "notes": {
      "kind": "adult_writable",
      "steward_writes_only": true
    }
  },
  "publishes": ["note.created"],
  "publish_acls": {"note.created": {"require_role": "member"}},
  "nav": {
    "label": "Notes"
  },
  "resource_limits": { "max_db_bytes": 10485760 },
  "icon": "📝"
}
