{
  "scenarios": [
    {
      "name": "the whole household reads shared notes, but only adults write, edit, or delete them",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "db",
          "as": "parent",
          "sql": "INSERT INTO app_notes__notes (id, title, content, created_by, created_at, updated_at) VALUES ('n1', 'Wifi', 'hunter2', ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": [
            "{{parent}}"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "SELECT id, title, content FROM app_notes__notes",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "id": "n1",
                "title": "Wifi",
                "content": "hunter2"
              }
            ]
          }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "INSERT INTO app_notes__notes (id, title, content, created_by, created_at, updated_at) VALUES ('n2', 'Kid note', 'hi', ?, '2026-01-02T00:00:00Z', '2026-01-02T00:00:00Z')",
          "params": [
            "{{kid}}"
          ],
          "expect": {
            "status": 403
          }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "UPDATE app_notes__notes SET content = 'changed' WHERE id = 'n1'",
          "expect": {
            "status": 403
          }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "DELETE FROM app_notes__notes WHERE id = 'n1'",
          "expect": {
            "status": 403
          }
        },
        {
          "action": "db",
          "as": "parent",
          "sql": "UPDATE app_notes__notes SET content = 'correct horse', updated_at = '2026-01-03T00:00:00Z' WHERE id = 'n1'",
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "parent",
          "sql": "SELECT id, content FROM app_notes__notes",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "id": "n1",
                "content": "correct horse"
              }
            ]
          }
        }
      ]
    }
  ]
}
